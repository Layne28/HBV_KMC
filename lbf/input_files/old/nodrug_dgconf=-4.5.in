#Observer
output_dir: ./data/nodrug_dgconf=-4.5
config_freq: 10000
thermo_freq: 10000
print_freq: 10000

#Run info
equil_steps: 10000
production_steps: 100000000
info_freq: 100000
simulation: standard

#Monte Carlo parameters
ks0: 0.02
kd0: 0.0000000000000001

###########################
#System/Geometry parameters
###########################

#change epsilon0 -> kappa_l
epsilon0: 4200
#change kappa0 -> kappa_phi
kappa0: 40
#change kappaPhi0 -> kappa_theta
kappaPhi0: 800

#Dihedral angles
theta0: 0.240
theta1: 0.480

#Dimer-dimer binding affinities
gb0: -9.8
dg12: 0.3
dg01: 0.1
dg20: -0.1
dg33: 0.0
dg00: -0.8
dgother: -0.95

#Chemical potentials
#muCD is ln(10muM)
muCD: -11.5
#muCD: -10.1
#dmu controls the conformational
#free energy difference between AB and CD
dmu: -4.5

#Drug parameters
#mudrug is very small
mudrug: -1000
#Drug-dimer binding affinity made up for now
gdrug0: 10.0


  
