#Observer
output_dir: ./data/mod_salt_aa_params_apo_holo
config_freq: 100
thermo_freq: 200
print_freq: 10000

#Run info
equil_steps: 1000
production_steps: 20000000
info_freq: 100
simulation: standard
initial_config: /home/lfrechet/research/capsid-assembly/hbv_assembly/disassembly/HBV_KMC/lbf/T4_restart.dat
stop_early: 0
stop_slow: 0
lenpoints: 200000000

#Monte Carlo parameters
ks0: 0.02
kd0: 0.00
#remove/insert dimers between two complete faces (lets a closed shell lose a dimer)
allow_interior_moves: 1

###########################
#System/Geometry parameters
###########################

#change epsilon0 -> kappa_l
epsilon0: 4200
#change kappa0 -> kappa_phi
kappa0: 40
#change kappaPhi0 -> kappa_theta
kappaPhi0: 800

#Dihedral angles
theta0: 0.234
theta1: 0.482

#Binding angles
phi0: 1.047
phi1: 1.172
phi2: 0.985
phi3: 0.985

#Bond lengths
l0: 1.143
l1: 1.034
l2: 1.034
l3: 1.143

#l0h: 1.292
l0h: 1.35
l1h: 1.068
l2h: 1.068
#l3h: 1.292
l3h: 1.35

#Dimer-dimer binding affinities
gb0: -10.8
dg12: 0.081
dg01: -0.107
dg20: -0.065
dg33: 0.0
dg00: -0.5
dgother: -0.95

#Chemical potentials
#muCD is ln(10muM)
muCD: -11.5
#dmu controls the conformational
#free energy difference between AB and CD
dmu: -3.5
#G_holo - G_apo; positive values disfavor holo (in units of kT)
dG_apoholo: -50

#Drug parameters
#mudrug is ln(40muM)
mudrug: -100.0
#Drug-dimer binding affinity made up for now
gdrug0: 0.0
