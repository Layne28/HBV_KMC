#Observer
output_dir: ./diamond_DC_assembly
config_freq: 10
thermo_freq: 10
print_freq: 10

#Run info
equil_steps: 1000
production_steps: 10000
info_freq: 1000
simulation: standard
initial_config: diamond_DC
do_vertex_only: 0

#Monte Carlo parameters
ks0: 0.002
kd0: 0.002

###########################
#System/Geometry parameters
###########################

#change epsilon0 -> kappa_l
epsilon0: 4200
#change kappa0 -> kappa_phi
kappa0: 40
#change kappaPhi0 -> kappa_theta
kappaPhi0: 800

#Dihedral angles
theta0: 0.240
theta1: 0.480

#Dimer-dimer binding affinities
gb0: -9.8
#gb0: 10.0
dg12: 0.3
dg01: 0.1
dg20: -0.1
dg33: 0.0
#dg00: 0.0
dg00: -0.6
dgother: -0.95

#Chemical potentials
#muCD is ln(10muM)
muCD: 0
#dmu controls the conformational
#free energy difference between AB and CD
dmu: -1000.5

#Drug parameters
#mudrug is ln(40muM)
mudrug: -100000.1
#Drug-dimer binding affinity made up for now
gdrug0: -17.0


  
