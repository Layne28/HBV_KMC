#Observer
output_dir: ./data/mod_salt_aa_params_crosslinked_gb=-6
config_freq: 100
thermo_freq: 200
print_freq: 100

#Run info
equil_steps: 1000
production_steps: 2000000
info_freq: 100
simulation: standard
initial_config: /home/laynefrechette/capsid-assembly/HBV_KMC/lbf/T4_restart.dat
stop_early: 0
stop_slow: 0
lenpoints: 200000000

#Monte Carlo parameters
ks0: 0.02
kd0: 0.00

###########################
#System/Geometry parameters
###########################

#change epsilon0 -> kappa_l
epsilon0: 4200
#change kappa0 -> kappa_phi
kappa0: 40
#change kappaPhi0 -> kappa_theta
kappaPhi0: 800

#Dihedral angles
theta0: 0.245
theta1: 0.470

#Binding angles
phi0: 1.047
phi1: 1.176
phi2: 0.983
phi3: 0.983

#Bond lengths
l0: 1.157
l1: 1.041
l2: 1.041
l3: 1.157

#Dimer-dimer binding affinities
gb0: -6
dg12: 0.119
dg01: -0.151
dg20: -0.046
dg33: -0.002
dg00: -0.5
dgother: -0.95

#Chemical potentials
#muCD is ln(10muM)
muCD: -11.5
#dmu controls the conformational
#free energy difference between AB and CD
dmu: -4.5

#Drug parameters
#mudrug is ln(40muM)
mudrug: -100.0
#Drug-dimer binding affinity made up for now
gdrug0: 0.0


  
