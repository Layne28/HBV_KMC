#Observer
output_dir: ./T4
config_freq: 10000
thermo_freq: 1000
print_freq: 10000
restart_freq: 100000

#Run info
equil_steps: 1000
production_steps: 10000000
info_freq: 10000
simulation: standard
do_vertex_only: 0

#Monte Carlo parameters
ks0: 0.002
kd0: 0.002

###########################
#System/Geometry parameters
###########################

#change epsilon0 -> kappa_l
epsilon0: 4200
#change kappa0 -> kappa_phi
kappa0: 40
#change kappaPhi0 -> kappa_theta
kappaPhi0: 800

#Dihedral angles
theta0: 0.240
theta1: 0.480

#Dimer-dimer binding affinities
gb0: -9.85
dg12: 0.3
dg01: 0.1
dg20: -0.1
dg33: 0.0
dg00: -0.6
dgother: -0.95

#Chemical potentials
#muCD is ln(10muM)
#muCD: -11.5
muCD: -10.8
dmu: -4.5

#Drug parameters
#mudrug is ln(40muM)
#mudrug: -10.1
mudrug: -1000.0
#Drug-dimer binding affinity made up for now
gdrug0: -6.0


  
